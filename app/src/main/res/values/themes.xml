<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PureLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dark background prevents white flash when launcher resumes -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <!-- Kill entrance/exit window animations for instant feel -->
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
    </style>

    <style name="Theme.PureLauncher" parent="Base.Theme.PureLauncher" />

    <!-- Zero-duration animations: launcher feels instantaneous on resume -->
    <style name="NoWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
    </style>

    <!-- Dark AlertDialog style for launcher dialogs -->
    <style name="DarkDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@drawable/bg_dialog_rounded</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/text_primary</item>
    </style>

</resources>