<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher root layout.
    Architecture:
    - Home + Vault + Settings pages
    - App drawer overlays from the bottom as a sliding sheet
    - Bottom nav pill floats above everything
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── Page container (Home / Vault / Settings) ────────────────────────── -->
    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include android:id="@+id/pageHome"    layout="@layout/view_launcher_home_panel" />

        <include android:id="@+id/pageVault"   layout="@layout/view_launcher_vault_panel"
            android:visibility="gone" />

        <include android:id="@+id/pageSettings"      layout="@layout/view_launcher_qr_panel"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ── App drawer bottom sheet overlay ──────────────────────────────────── -->
    <!--
        Starts at translationY = full height (off-screen below).
        Slides up on swipe-up, partially covering the home screen.
        Has rounded top corners and a pull handle.
    -->
    <FrameLayout
        android:id="@+id/appDrawerSheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_drawer_sheet"
        android:translationY="2000dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pull handle bar -->
        <View
            android:id="@+id/drawerHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drawer_handle" />

        <!-- Embedded app search content -->
        <include layout="@layout/activity_app_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- ── Bottom nav pill (floats above everything) ───────────────────────── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNav"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_marginBottom="20dp"
        android:elevation="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="34dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_active"
                android:contentDescription="Home"
                android:padding="12dp"
                android:src="@drawable/ic_home"
                android:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/navVault"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Vault"
                android:padding="12dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/text_primary"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/navSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_primary"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
